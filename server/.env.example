# Copy to .env and fill in. Never commit .env.
PORT=3001
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Demo seeding — OFF by default. Set to 'true' ONLY on a trial/demo
# deployment. A copied deployment for a real client must start empty
# (no demo accounts with public passwords) and onboard real users.
SEED_DEMO_DATA=true

# Encryption for provider API keys stored in the database (AES-256-GCM).
# Optional: when unset, a key is derived from JWT_SECRET. Real-client
# deployments should set this explicitly (32 random bytes, 64 hex chars).
# ENCRYPTION_KEY=

# Database — local dev uses a SQLite file (server/data/clinix.db).
# Production (Vercel): set these to a Turso database you own, created
# manually in the Turso dashboard. Do NOT use Vercel's one-click Turso
# integration — it provisions the DB inside Vercel's own Turso org, where
# it is invisible in your dashboard and its credentials are sealed.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# AI provider (OpenAI-compatible). The key stays on the server — never shipped to the browser.
AI_PROVIDER_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Legacy local override (optional): a file path instead of the default.
# DB_PATH=./data/clinix.db
