# Copy to .env and fill in. Never commit .env.
PORT=3001
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Database — local dev uses a SQLite file (server/data/clinix.db).
# Production (Vercel): set these to a Turso database. The Vercel Turso
# integration injects them automatically — no manual values needed then.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# AI provider (OpenAI-compatible). The key stays on the server — never shipped to the browser.
AI_PROVIDER_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Legacy local override (optional): a file path instead of the default.
# DB_PATH=./data/clinix.db
